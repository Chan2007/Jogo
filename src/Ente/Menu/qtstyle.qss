#topBarLabel,
#heroTitleLabel,
#heroSubtitleLabel,
#statusLabel,
#settingLabelMusic,
#settingLabelVolume,
#volumeValueLabel,
#phase1SelectPagePlayer1Label,
#phase1SelectPagePlayer2Label,
#phase2SelectPagePlayer1Label,
#phase2SelectPagePlayer2Label {
    font-family: "Segoe UI", "Arial", "Helvetica";
    color: #000000;
    font-weight: bold;
}

#settingsTitleLabel,
#loadGameTitleLabel,
#rankingTitleLabel,
#phase1SelectPageTitleLabel,
#phase2SelectPageTitleLabel {
    font-size: 27px;
    font-family: "Segoe UI", "Arial", "Helvetica";
    font-weight: bold;
    color: #000000;
}

#settingsSubtitleLabel,
#loadGameSubtitleLabel,
#rankingSubtitleLabel,
#phase1SelectPageSubtitleLabel,
#phase2SelectPageSubtitleLabel {
    color: #000000;
    font-size: 14px;
    font-family: "Segoe UI", "Arial", "Helvetica";
}

#sectionTitleLabel {
    border-bottom: 2px solid black;
    font-size: 15px;
    letter-spacing: 3px;
    padding-bottom: 8px;
    padding-top: 4px;
}

#phase1SelectPagePlayer1Label,
#phase1SelectPagePlayer2Label,
#phase2SelectPagePlayer1Label,
#phase2SelectPagePlayer2Label {
    font-size: 13px;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(0,0,0,0.15);
    padding-bottom: 4px;
}

#topBarLabel {
    font-size: 21px;
}

#heroTitleLabel {
    font-size: 56px;
    letter-spacing: 1px;
}
#heroSubtitleLabel {
    font-size: 14px;
}
#statusLabel {
    font-size: 11px;
    padding-top: 20px;
}

#settingLabelMusic,
#settingLabelVolume {
    font-size: 17px;
}
#volumeValueLabel {
    font-size: 17px;
    letter-spacing: 1px;
    min-width: 38px;
}

#settingsPanel,
#loadGamePanel,
#rankingPanel,
#phase1SelectPanel,
#phase2SelectPanel {
    border: none;
    padding: 52px 52px 36px 52px;
    min-width: 1000px;
    min-height: 700px;
}

QWidget #settingsPage,
QWidget #loadGamePage,
QWidget #rankingPage,
QWidget #phase1SelectPage,
QWidget #phase2SelectPage {
    background: transparent;
}

QWidget #settingsPanel,
QWidget #loadGamePanel,
QWidget #rankingPanel,
QWidget #phase1SelectPanel,
QWidget #phase2SelectPanel {
    border-radius: 20px;
    border: 1px solid transparent;
}

/* ── MenuButton: layout e espaçamento ─────────────────────────────────────
   NOTA: font-family/font-size/font-weight/text-align NÃO chegam ao
   QPainter::drawText() do paintEvent customizado do MenuButton.
   A fonte é controlada pela propriedade <font> inline no .ui (que o Qt
   passa para painter.font() antes do paintEvent rodar).
   Aqui ficam apenas as propriedades que o Qt box-model processa:
   padding, margin, min/max-size e background. ────────────────────────── */

/* Botões do menu principal: padding-left empurra o texto para coincidir
   com a animação de deslizamento da entrada. */
#mainMenuPanel MenuButton {
    background-color: transparent;
    padding: 0px 0px 0px 200px;
    margin: 0px;
}

/* Botões nos painéis secundários (Voltar / Iniciar):
   padding zerado para o texto não ficar deslocado. */
#settingsPanel MenuButton,
#loadGamePanel MenuButton,
#rankingPanel MenuButton,
#phase1SelectPanel MenuButton,
#phase2SelectPanel MenuButton {
    background-color: transparent;
    margin: 0px;
    padding: 0px;
    min-width: 500px;
    min-height: 48px;
    max-height: 64px;
}

#mainMenuPanel {
    max-width: 400px;
}

/* ── Tabela de Ranking ──────────────────────────────────────────────────── */

#rankingTable {
    background-color: transparent;
    border: none;
    font-family: "Segoe UI", "Arial", "Helvetica";
    font-size: 16px;
    color: #000000;
    outline: none;
}

/* Cabeçalho das colunas */
#rankingTable QHeaderView::section {
    background-color: transparent;
    font-family: "Segoe UI", "Arial", "Helvetica";
    font-size: 16px;
    font-weight: bold;
    color: #000000;
    border: none;
    border-bottom: 2px solid rgba(0, 0, 0, 0.25);
    padding: 8px 10px;
}

/* Linhas alternadas para facilitar a leitura */
#rankingTable QTableView {
    alternate-background-color: rgba(0, 0, 0, 0.04);
}

/* Linha selecionada */
#rankingTable::item:selected {
    background-color: rgba(0, 0, 0, 0.10);
    color: #000000;
}

/* Separador sutil entre linhas */
#rankingTable::item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    padding: 4px 10px;
}

/* Scrollbar discreta dentro da tabela */
#rankingTable QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0px;
}
#rankingTable QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.20);
    border-radius: 3px;
    min-height: 20px;
}
#rankingTable QScrollBar::add-line:vertical,
#rankingTable QScrollBar::sub-line:vertical {
    height: 0px;
}
