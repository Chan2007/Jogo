QMainWindow {
    background-color: transparent;
}

QMenuBar,
QStatusBar {
    background: transparent;
    color: transparent;
    border: 0;
}

#centralwidget {
    background: transparent;
}

/* stackedWidget deve ser transparente para o BackgroundWidget
   aparecer através dele, mas as páginas têm fundos próprios */
#stackedWidget {
    background: transparent;
}

/* MENU PRINCIPAL - Fundo Escuro com Transparência */
#mainPage {
    background: transparent;
}

/* TELA DE CONFIGURAÇÕES - Fundo Azul Escuro (Contraste Forte) */
#settingsPage {
    background-color: #1a2d4d;
    border: 3px solid #00ff00;
}

#mainMenuPanel {
    background: transparent;
}

#topBarLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #00ff00;
    font-size: 11px;
    font-weight: bold;
}

#heroTitleLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffffff;
    font-size: 56px;
    font-weight: bold;
}

#heroSubtitleLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffff00;
    font-size: 14px;
    font-weight: bold;
}

#statusLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #00ffff;
    font-size: 11px;
    padding-top: 8px;
    font-weight: bold;
}

#mainMenuPanel QPushButton {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    font-size: 18px;
    color: #ffffff;
    background-color: #003300;
    border: 2px solid #00ff00;
    border-left: 4px solid #00ff00;
    padding: 10px 0 10px 18px;
    text-align: left;
    min-width: 280px;
    max-width: 360px;
    font-weight: bold;
}

#mainMenuPanel QPushButton:hover {
    color: #000000;
    background-color: #00ff00;
    border: 2px solid #ffff00;
    border-left: 4px solid #ffff00;
    padding-left: 26px;
    font-weight: bold;
}

#mainMenuPanel QPushButton:pressed {
    color: #000000;
    background-color: #ffff00;
    border: 2px solid #ff0000;
    border-left: 4px solid #ff0000;
    padding-left: 30px;
    font-weight: bold;
}

/* ═══════════════════════════════════════════════════════
   TELA DE CONFIGURAÇÕES
   Fundo azul escuro com bordas verde limão para contraste
   ═══════════════════════════════════════════════════════ */

#settingsPanel {
    background-color: #FF00F4;
    border: 3px solid #00ff00;
    border-radius: 0px;
    padding: 40px 52px 36px 52px;
    min-width: 480px;
    max-width: 640px;
}

#innerFrame {
    border: 2px solid #00ff00;
    background-color: #005FFF;
    padding: 24px 28px;
}

/* Título das configurações */
#settingsTitleLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffff00;
    font-size: 17px;
    font-weight: bold;
    letter-spacing: 8px;
}

/* Subtítulo */
#settingsSubtitleLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #00ffff;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 4px;
}

/* Rótulos de seção */
#sectionTitleLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #00ff00;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 6px;
    border-bottom: 2px solid #00ff00;
    padding-bottom: 8px;
    padding-top: 4px;
}

/* Rótulos de controles */
#settingLabelMusic,
#settingLabelVolume {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

#volumeValueLabel {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffff00;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    min-width: 38px;
}

/* Frame de seção dentro do painel */
QFrame[sectionFrame="true"] {
    background-color: #4C4D19;
    border-top: 2px solid #00ff00;
    border-bottom: 2px solid #00ff00;
    border-left: 0;
    border-right: 0;
    border-radius: 0px;
}

/* Botão "Voltar ao Menu" */
#settingsPanel QPushButton {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    font-size: 11px;
    letter-spacing: 5px;
    color: #000000;
    background-color: #00ff00;
    border: 2px solid #ffff00;
    border-radius: 0px;
    padding: 10px 32px;
    min-width: 200px;
    font-weight: bold;
}

#settingsPanel QPushButton:hover {
    color: #000000;
    background-color: #ffff00;
    border: 2px solid #ff0000;
}

#settingsPanel QPushButton:pressed {
    color: #ffffff;
    background-color: #ff0000;
    border: 2px solid #ffff00;
}

/* CHECKBOX CUSTOMIZADO */
QCheckBox {
    font-family: "Palatino Linotype", "Book Antiqua", "Georgia";
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 1px;
    border: 2px solid #00ff00;
    background-color: #003300;
}

QCheckBox::indicator:hover {
    border: 2px solid #ffff00;
    background-color: #005500;
}

QCheckBox::indicator:checked {
    background-color: #00ff00;
    border: 2px solid #ffff00;
}

/* SLIDER CUSTOMIZADO */
QSlider::groove:horizontal {
    border: 0;
    height: 4px;
    background-color: #003300;
    border: 1px solid #00ff00;
}

QSlider::sub-page:horizontal {
    background-color: #00ff00;
    height: 4px;
}

QSlider::add-page:horizontal {
    background-color: #003300;
    height: 4px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background-color: #ffff00;
    border: 2px solid #00ff00;
}
